ANTHROPIC_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Secret for the owner-only waitlist admin page (public/admin-waitlist.html).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=
# Optional — only works once support@neurovance.dev is verified as a
# "Send mail as" address in GMAIL_USER's own Gmail settings. Falls back to
# sending as GMAIL_USER if unset.
GMAIL_SEND_AS="Neurovance" <support@neurovance.dev>

# Google OAuth — create credentials at console.cloud.google.com (OAuth
# consent screen + OAuth client ID, type "Web application"). Free, no
# billing needed. Redirect URI must exactly match what's registered there,
# e.g. https://app.neurovance.dev/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub OAuth — create at github.com/settings/developers > OAuth Apps >
# New OAuth App. Free. Authorization callback URL must exactly match, e.g.
# https://app.neurovance.dev/api/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Firestore — real persistence, since local memory/ JSON files get wiped on
# every deploy (no persistent disk). Get these from a Firebase project's
# Project Settings > Service Accounts > Generate new private key. Free
# (Spark plan) at this app's scale.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Session/OAuth cookies get the Secure flag by default (HTTPS-only). Set to
# false ONLY for non-HTTPS local development.
COOKIE_SECURE=false

# Code execution is a real interpreter/dev-server spawner with machine
# access. Enable ONLY in your own local dev .env — never in production.
ENABLE_LOCAL_CODE_EXECUTION=1

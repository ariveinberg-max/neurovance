{
  "manifest_version": 3,
  "name": "Neurovance Companion",
  "version": "0.2.0",
  "description": "Chat with your Superself from a side panel in Chrome, and let it open links, read the page you're on, click things, and fill in fields — only when you ask.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["scripting", "tabs", "storage", "alarms", "sidePanel"],
  "host_permissions": ["<all_urls>"]
}
